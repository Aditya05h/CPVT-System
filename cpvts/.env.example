PORT=5173
HOST=127.0.0.1
# local = persistent embedded PostgreSQL; supabase = your hosted PostgreSQL
DATABASE_MODE=local
LOCAL_DATA_DIR=./data/parking
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Preferred Supabase connection, server only. Copy your Session pooler URL here.
DATABASE_URL=
# Bundled public Supabase CA; certificate and hostname verification stay enabled.
DATABASE_CA_CERT=./certs/supabase-ca.crt
# Optional alternative: Data API when DATABASE_URL is empty. Never use a VITE_ prefix.
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
